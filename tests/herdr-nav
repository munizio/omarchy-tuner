#!/usr/bin/env bash
# ensure_herdr_nav.py: Omarchy herdr keys → workspace next/prev without
# leaving close_tab / close_workspace on prefix+k / prefix+shift+k.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/share/ensure_herdr_nav.py"

fail=0
pass=0

assert_eq() {
  local name="$1" got="$2" want="$3"
  if [[ $got == "$want" ]]; then
    printf 'ok  %s\n' "$name"
    pass=$((pass + 1))
  else
    printf 'FAIL %s\n  got:  %q\n  want: %q\n' "$name" "$got" "$want"
    fail=$((fail + 1))
  fi
}

toml_get() {
  local file="$1" key="$2"
  python3 - "$file" "$key" <<'PY'
import pathlib, sys, tomllib
keys = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["keys"]
val = keys[sys.argv[2]]
if isinstance(val, list):
    print("[" + ", ".join(f'"{x}"' for x in val) + "]")
else:
    print(f'"{val}"')
PY
}

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

omarchy="$WORKDIR/omarchy.toml"
cat >"$omarchy" <<'EOF'
[keys]
prefix = "ctrl+a"
close_tab = "prefix+k"
close_workspace = "prefix+shift+k"
previous_workspace = ["prefix+shift+p", "alt+up"]
next_workspace = ["prefix+shift+n", "alt+down"]
EOF

result="$(python3 "$PY" "$omarchy")"
assert_eq "omarchy keys rewritten" "$result" "updated"
assert_eq "close_tab leaves prefix+k" "$(toml_get "$omarchy" close_tab)" '"prefix+shift+x"'
assert_eq "close_workspace leaves prefix+shift+k" "$(toml_get "$omarchy" close_workspace)" '"prefix+shift+d"'
assert_eq "previous_workspace is prefix+k" "$(toml_get "$omarchy" previous_workspace)" '["prefix+k", "alt+up"]'
assert_eq "next_workspace is prefix+j" "$(toml_get "$omarchy" next_workspace)" '["prefix+j", "alt+down"]'

result="$(python3 "$PY" "$omarchy")"
assert_eq "second run is a no-op" "$result" "ok"

result="$(CHECK=1 python3 "$PY" "$omarchy")"
assert_eq "check on applied file is ok" "$result" "ok"

stale="$WORKDIR/stale.toml"
cp "$omarchy" "$stale"
python3 - "$stale" <<'PY'
from pathlib import Path
p = Path(__import__("sys").argv[1])
p.write_text(p.read_text().replace("prefix+shift+d", "prefix+shift+k"))
PY
result="$(CHECK=1 python3 "$PY" "$stale")"
assert_eq "check reports leftover close_workspace" "$result" "stale"
assert_eq "check does not write" "$(toml_get "$stale" close_workspace)" '"prefix+shift+k"'

custom="$WORKDIR/custom.toml"
cat >"$custom" <<'EOF'
[keys]
prefix = "ctrl+a"
close_tab = "prefix+shift+x"
close_workspace = "prefix+shift+q"
previous_workspace = ["prefix+k", "alt+up"]
next_workspace = ["prefix+j", "alt+down"]
EOF
result="$(python3 "$PY" "$custom")"
assert_eq "non-conflicting close_workspace is left alone" "$result" "ok"
assert_eq "custom close_workspace kept" "$(toml_get "$custom" close_workspace)" '"prefix+shift+q"'

printf '\n%d passed, %d failed\n' "$pass" "$fail"
exit $((fail > 0))
